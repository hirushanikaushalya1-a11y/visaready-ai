# ---------------------------------------------------------------- core
ENVIRONMENT=development                # development | test | production
PUBLIC_BASE_URL=http://localhost:3000  # where users open the app
API_PUBLIC_URL=http://localhost:8000   # must be public in production (payment webhooks)
DATABASE_URL=postgresql+psycopg://visaready:visaready_dev@localhost:5432/visaready

# ---------------------------------------------------------------- security (REQUIRED in production)
SECRET_KEY=change-me-to-64-random-characters-change-me-to-64-random-characters
# 32 random bytes, base64url:  python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
STORAGE_MASTER_KEY=
COOKIE_SECURE=false                    # true behind HTTPS
# RATE_LIMIT_REDIS_URL=redis://localhost:6379/0   # share rate limits across instances

# ---------------------------------------------------------------- storage
STORAGE_BACKEND=local_encrypted        # local_encrypted | s3 (s3 adapter awaiting integration)
STORAGE_LOCAL_PATH=./var/storage

# ---------------------------------------------------------------- package limits (shown before payment)
MAX_DOCUMENTS_PER_APPLICATION=40
MAX_FILE_SIZE_MB=15
INCLUDED_REASSESSMENTS=3
RETENTION_DAYS_AFTER_COMPLETION=30     # default; admins can override in the dashboard

# ---------------------------------------------------------------- AI (optional; platform works without it)
AI_PROVIDER=none                       # none | anthropic | openai  (anthropic = Claude case review)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
AI_PER_DOCUMENT_EXTRACTION=false       # extra AI call per upload; off = faster uploads
WORKER_THREADS=3                       # documents processed in parallel
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# ---------------------------------------------------------------- payments
PAYMENT_PROVIDER=sandbox               # sandbox (test only) | payhere
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_APP_ID=                        # Refund API
PAYHERE_APP_SECRET=
PAYHERE_SANDBOX=true

# ---------------------------------------------------------------- email
EMAIL_BACKEND=outbox                   # outbox (records only, sends nothing) | smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=VisaReady AI <no-reply@yourdomain.com>
DOCUMENT_SERVICE_EMAIL=documents@yourdomain.com
SUPPORT_EMAIL=support@yourdomain.com

# ---------------------------------------------------------------- writing service SLA
WRITING_SLA_HOURS=24
WRITING_SLA_WARNING_HOURS=4

# ---------------------------------------------------------------- frontend (Next.js server only; never exposed to browser)
API_INTERNAL_URL=http://127.0.0.1:8000

# ---------------------------------------------------------------- seeding
# SEED_ADMIN_EMAIL=you@yourdomain.com
# SEED_ADMIN_PASSWORD=
